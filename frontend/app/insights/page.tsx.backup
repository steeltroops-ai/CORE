                     <CardHeader>
                       <CardTitle className="text-white flex items-center gap-2">
                         <DollarSign className="h-5 w-5 text-yellow-400" />
                         5. Investment Alignment
                       </CardTitle>
                       <CardDescription className="text-slate-400">
                         VC matching and funding stage assessment
                       </CardDescription>
                     </CardHeader>
                     <CardContent>
                       <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                         {/* Funding Stage Badge */}
                         <div className="p-4 bg-slate-900/50 rounded-lg border border-slate-700 text-center">
                           <h4 className="text-sm font-semibold text-white mb-3">Funding Stage</h4>
                           <Badge className="bg-blue-500/20 text-blue-300 border-blue-500/30 text-lg px-4 py-2 mb-2">
                             Series A
                           </Badge>
                           <p className="text-xs text-slate-400">Recommended stage based on TRL/MRL</p>
                         </div>
                         
                         {/* VC Cards */}
                         <div className="p-4 bg-slate-900/50 rounded-lg border border-slate-700">
                           <h4 className="text-sm font-semibold text-white mb-3">Top Aligned VCs</h4>
                           <div className="space-y-3">
                             <div className="flex items-center justify-between p-2 bg-slate-800 rounded">
                               <div className="flex items-center gap-2">
                                 <div className="w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center text-xs font-bold text-white">A</div>
                                 <span className="text-xs text-white">Andreessen Horowitz</span>
                               </div>
                               <div className="text-right">
                                 <div className="text-xs text-emerald-300">95%</div>
                                 <Progress value={95} className="h-1 w-12" />
                               </div>
                             </div>
                             <div className="flex items-center justify-between p-2 bg-slate-800 rounded">
                               <div className="flex items-center gap-2">
                                 <div className="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center text-xs font-bold text-white">S</div>
                                 <span className="text-xs text-white">Sequoia Capital</span>
                               </div>
                               <div className="text-right">
                                 <div className="text-xs text-blue-300">89%</div>
                                 <Progress value={89} className="h-1 w-12" />
                               </div>
                             </div>
                             <div className="flex items-center justify-between p-2 bg-slate-800 rounded">
                               <div className="flex items-center gap-2">
                                 <div className="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center text-xs font-bold text-white">K</div>
                                 <span className="text-xs text-white">Kleiner Perkins</span>
                               </div>
                               <div className="text-right">
                                 <div className="text-xs text-purple-300">82%</div>
                                 <Progress value={82} className="h-1 w-12" />
                               </div>
                             </div>
                           </div>
                         </div>
                         
                         {/* Benchmark Chart */}
                         <div className="p-4 bg-slate-900/50 rounded-lg border border-slate-700">
                           <h4 className="text-sm font-semibold text-white mb-3">Deal Size Benchmarks</h4>
                           <div className="space-y-3">
                             <div>
                               <div className="flex justify-between mb-1">
                                 <span className="text-xs text-slate-400">Seed</span>
                                 <span className="text-xs text-white">$0.5M - $2M</span>
                               </div>
                               <div className="h-2 bg-slate-700 rounded overflow-hidden">
                                 <div className="h-full bg-gradient-to-r from-slate-600 to-slate-500 w-1/4"></div>
                               </div>
                             </div>
                             <div>
                               <div className="flex justify-between mb-1">
                                 <span className="text-xs text-slate-400">Series A</span>
                                 <span className="text-xs text-emerald-300">$5M - $15M</span>
                               </div>
                               <div className="h-2 bg-slate-700 rounded overflow-hidden">
                                 <div className="h-full bg-gradient-to-r from-emerald-500 to-emerald-400 w-3/4"></div>
                               </div>
                             </div>
                             <div>
                               <div className="flex justify-between mb-1">
                                 <span className="text-xs text-slate-400">Series B</span>
                                 <span className="text-xs text-white">$15M - $50M</span>
                               </div>
                               <div className="h-2 bg-slate-700 rounded overflow-hidden">
                                 <div className="h-full bg-gradient-to-r from-slate-600 to-slate-500 w-1/2"></div>
                               </div>
                             </div>
                           </div>
                         </div>
                       </div>
                     </CardContent>
                   </Card>
                   
                   {/* Section 6: Actionable Outputs */}
                   <Card className="bg-slate-800/50 border-slate-700">
                     <CardHeader>
                       <CardTitle className="text-white flex items-center gap-2">
                         <Target className="h-5 w-5 text-red-400" />
                         6. Actionable Outputs
                       </CardTitle>
                       <CardDescription className="text-slate-400">
                         Export, track, and manage your research pipeline
                       </CardDescription>
                     </CardHeader>
                     <CardContent>
                       <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                         {/* Action Buttons */}
                         <div className="space-y-4">
                           <div className="p-4 bg-slate-900/50 rounded-lg border border-slate-700">
                             <h4 className="text-sm font-semibold text-white mb-3">Quick Actions</h4>
                             <div className="grid grid-cols-1 gap-2">
                               <Button className="bg-emerald-600 hover:bg-emerald-700 text-white justify-start">
                                 <Download className="h-4 w-4 mr-2" />
                                 Generate Executive Summary
                               </Button>
                               <Button variant="outline" className="border-slate-600 text-slate-300 hover:bg-slate-700 justify-start">
                                 <FileText className="h-4 w-4 mr-2" />
                                 Export Pitch Deck
                               </Button>
                               <Button variant="outline" className="border-slate-600 text-slate-300 hover:bg-slate-700 justify-start">
                                 <Plus className="h-4 w-4 mr-2" />
                                 Add to GTM Lab
                               </Button>
                               <Button variant="outline" className="border-slate-600 text-slate-300 hover:bg-slate-700 justify-start">
                                 <Share2 className="h-4 w-4 mr-2" />
                                 Share with Team
                               </Button>
                             </div>
                           </div>
                         </div>
                         
                         {/* Pipeline Tracking */}
                         <div className="p-4 bg-slate-900/50 rounded-lg border border-slate-700">
                           <h4 className="text-sm font-semibold text-white mb-3">Pipeline Status</h4>
                           <div className="space-y-3">
                             <div className="flex items-center justify-between p-2 bg-slate-800 rounded">
                               <div className="flex items-center gap-2">
                                 <div className="w-2 h-2 bg-emerald-400 rounded-full"></div>
                                 <span className="text-xs text-white">Research Complete</span>
                               </div>
                               <CheckCircle className="h-4 w-4 text-emerald-400" />
                             </div>
                             <div className="flex items-center justify-between p-2 bg-slate-800 rounded">
                               <div className="flex items-center gap-2">
                                 <div className="w-2 h-2 bg-yellow-400 rounded-full"></div>
                                 <span className="text-xs text-white">IP Filing</span>
                               </div>
                               <Clock className="h-4 w-4 text-yellow-400" />
                             </div>
                             <div className="flex items-center justify-between p-2 bg-slate-800 rounded">
                               <div className="flex items-center gap-2">
                                 <div className="w-2 h-2 bg-slate-400 rounded-full"></div>
                                 <span className="text-xs text-white">VC Outreach</span>
                               </div>
                               <Clock className="h-4 w-4 text-slate-400" />
                             </div>
                             <div className="flex items-center justify-between p-2 bg-slate-800 rounded">
                               <div className="flex items-center gap-2">
                                 <div className="w-2 h-2 bg-slate-400 rounded-full"></div>
                                 <span className="text-xs text-white">Market Entry</span>
                               </div>
                               <Clock className="h-4 w-4 text-slate-400" />
                             </div>
                           </div>
                         </div>
                       </div>
                     </CardContent>
                   </Card>
                   
                   {/* Summary Dashboard Cards */}
                   <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                     {/* Project Card */}
                     <Card className="bg-slate-800/50 border-slate-700">
                       <CardContent className="p-4">
                         <div className="text-center">
                           <h4 className="text-sm font-semibold text-white mb-2">Project Overview</h4>
                           <div className="text-xs text-slate-400 mb-2">Neural Network Optimization</div>
                           <div className="flex justify-center gap-2 mb-2">
                             <div className="text-center">
                               <div className="text-sm font-bold text-blue-300">TRL 6</div>
                               <Progress value={67} className="h-1 w-8" />
                             </div>
                             <div className="text-center">
                               <div className="text-sm font-bold text-green-300">MRL 4</div>
                               <Progress value={80} className="h-1 w-8" />
                             </div>
                           </div>
                           <div className="text-lg font-bold text-emerald-300">78%</div>
                           <div className="text-xs text-slate-400">Novelty Score</div>
                         </div>
                       </CardContent>
                     </Card>
                     
                     {/* Market Card */}
                     <Card className="bg-slate-800/50 border-slate-700">
                       <CardContent className="p-4">
                         <div className="text-center">
                           <h4 className="text-sm font-semibold text-white mb-2">Market Potential</h4>
                           <div className="flex justify-center gap-1 mb-2">
                             <Badge className="bg-blue-500/20 text-blue-300 text-xs">AI</Badge>
                             <Badge className="bg-purple-500/20 text-purple-300 text-xs">Health</Badge>
                           </div>
                           <div className="text-lg font-bold text-emerald-300">72%</div>
                           <div className="text-xs text-slate-400 mb-2">Adoption Likelihood</div>
                           <div className="h-4 bg-slate-700 rounded overflow-hidden">
                             <div className="h-full bg-gradient-to-r from-emerald-500 to-emerald-300 w-3/4"></div>
                           </div>
                         </div>
                       </CardContent>
                     </Card>
                     
                     {/* VC Card */}
                     <Card className="bg-slate-800/50 border-slate-700">
                       <CardContent className="p-4">
                         <div className="text-center">
                           <h4 className="text-sm font-semibold text-white mb-2">Investment Match</h4>
                           <Badge className="bg-blue-500/20 text-blue-300 border-blue-500/30 mb-2">Series A</Badge>
                           <div className="space-y-1">
                             <div className="flex items-center gap-1">
                               <div className="w-3 h-3 bg-emerald-500 rounded-full"></div>
                               <span className="text-xs text-white">a16z</span>
                               <span className="text-xs text-emerald-300">95%</span>
                             </div>
                             <div className="flex items-center gap-1">
                               <div className="w-3 h-3 bg-blue-500 rounded-full"></div>
                               <span className="text-xs text-white">Sequoia</span>
                               <span className="text-xs text-blue-300">89%</span>
                             </div>
                           </div>
                         </div>
                       </CardContent>
                     </Card>
                     
                     {/* Risk Card */}
                     <Card className="bg-slate-800/50 border-slate-700">
                       <CardContent className="p-4">
                         <div className="text-center">
                           <h4 className="text-sm font-semibold text-white mb-2">Risk Assessment</h4>
                           <div className="space-y-1 mb-2">
                             <Badge variant="outline" className="border-yellow-500/30 text-yellow-300 text-xs">
                               Supply Chain
                             </Badge>
                             <Badge variant="outline" className="border-orange-500/30 text-orange-300 text-xs">
                               Regulatory
                             </Badge>
                           </div>
                           <div className="text-lg font-bold text-yellow-300">Medium</div>
                           <div className="text-xs text-slate-400">Overall Risk</div>
                         </div>
                       </CardContent>
                     </Card>
                     
                     {/* Action Card */}
                     <Card className="bg-slate-800/50 border-slate-700">
                       <CardContent className="p-4">
                         <div className="text-center">
                           <h4 className="text-sm font-semibold text-white mb-2">Next Actions</h4>
                           <div className="space-y-1">
                             <Button size="sm" className="bg-emerald-600 hover:bg-emerald-700 text-white w-full text-xs">
                               <Download className="h-3 w-3 mr-1" />
                               Export
                             </Button>
                             <Button size="sm" variant="outline" className="border-slate-600 text-slate-300 hover:bg-slate-700 w-full text-xs">
                               <Plus className="h-3 w-3 mr-1" />
                               GTM Lab
                             </Button>
                             <Button size="sm" variant="outline" className="border-slate-600 text-slate-300 hover:bg-slate-700 w-full text-xs">
                               <Share2 className="h-3 w-3 mr-1" />
                               Share
                             </Button>
                           </div>
                         </div>
                       </CardContent>
                     </Card>
                   </div>

                  {/* Developer Mode Toggle */}
                  {userPersona.id === 'developer' && (
                    <Card className="bg-slate-800/50 border-slate-700 mb-6">
                      <CardContent className="p-4">
                        <div className="flex items-center justify-between">
                          <div className="flex items-center gap-2">
                            <Code className="text-emerald-400" size={16} />
                            <span className="text-sm font-medium text-slate-300">Developer Mode</span>
                          </div>
                          <Button
                            variant="outline"
                            size="sm"
                            onClick={() => setShowDeveloperMode(!showDeveloperMode)}
                            className={`border-slate-600 text-slate-300 hover:bg-slate-700 ${
                              showDeveloperMode ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-300' : ''
                            }`}
                          >
                            {showDeveloperMode ? 'Hide' : 'Show'} Technical Details
                          </Button>
                        </div>
                        
                        {showDeveloperMode && (
                          <div className="mt-4 pt-4 border-t border-slate-700">
                            <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                              <div>
                                <div className="text-lg font-semibold text-emerald-300">
                                  {processingMetrics.apiCalls}
                                </div>
                                <div className="text-xs text-slate-400">Total API Calls</div>
                              </div>
                              <div>
                                <div className="text-lg font-semibold text-blue-300">
                                  {processingMetrics.tokensUsed.toLocaleString()}
                                </div>
                                <div className="text-xs text-slate-400">Tokens Used</div>
                              </div>
                              <div>
                                <div className="text-lg font-semibold text-purple-300">
                                  {processingMetrics.successRate.toFixed(1)}%
                                </div>
                                <div className="text-xs text-slate-400">Success Rate</div>
                              </div>
                              <div>
                                <div className="text-lg font-semibold text-yellow-300">
                                  {processingMetrics.averageResponseTime.toFixed(0)}ms
                                </div>
                                <div className="text-xs text-slate-400">Avg Response</div>
                              </div>
                            </div>
                          </div>
                        )}
                      </CardContent>
                    </Card>
                  )}

                  {/* Main Content Tabs */}
                  <Tabs value={activeTab} onValueChange={setActiveTab} className="w-full">
                    <TabsList className="grid w-full grid-cols-4 bg-slate-800/50 border-slate-700">
                      <TabsTrigger 
                        value="novelty" 
                        className="data-[state=active]:bg-blue-500/20 data-[state=active]:text-blue-300 text-slate-400"
                      >
                        <Lightbulb className="mr-2" size={16} />
                        Novelty
                      </TabsTrigger>
                      <TabsTrigger 
                        value="competitive" 
                        className="data-[state=active]:bg-red-500/20 data-[state=active]:text-red-300 text-slate-400"
                      >
                        <Target className="mr-2" size={16} />
                        Competitive
                      </TabsTrigger>
                      <TabsTrigger 
                        value="commercialization" 
                        className="data-[state=active]:bg-green-500/20 data-[state=active]:text-green-300 text-slate-400"
                      >
                        <TrendingUp className="mr-2" size={16} />
                        Commercial
                      </TabsTrigger>
                      <TabsTrigger 
                        value="strategic" 
                        className="data-[state=active]:bg-purple-500/20 data-[state=active]:text-purple-300 text-slate-400"
                      >
                        <Zap className="mr-2" size={16} />
                        Strategic
                      </TabsTrigger>
                    </TabsList>

                    <TabsContent value="novelty" className="mt-4">
                       <NoveltyAssessment 
                         analysisId={currentAnalysisId || ''}
                         showTechnicalDetails={userPersona.preferences.showTechnicalDetails}
                         onExport={handleExport}
                         onShare={handleShare}
                       />
                     </TabsContent>

                     <TabsContent value="competitive" className="mt-4">
                       <CompetitiveIntelligence 
                         analysisId={currentAnalysisId || ''}
                         showTechnicalDetails={userPersona.preferences.showTechnicalDetails}
                         onExport={handleExport}
                         onShare={handleShare}
                       />
                     </TabsContent>

                     <TabsContent value="commercialization" className="mt-4">
                       <CommercializationOpportunities 
                         analysisId={currentAnalysisId || ''}
                         showTechnicalDetails={userPersona.preferences.showTechnicalDetails}
                         onExport={handleExport}
                         onShare={handleShare}
                       />
                     </TabsContent>

                     <TabsContent value="strategic" className="mt-4">
                       <StrategicInsights 
                         analysisId={currentAnalysisId || ''}
                         showTechnicalDetails={userPersona.preferences.showTechnicalDetails}
                         onExport={handleExport}
                         onShare={handleShare}
                       />
                     </TabsContent>
                  </Tabs>
                </div>
              </div>
              </div>
              
              {/* Removed Accessibility Button and Developer Tools for cleaner UI */}
            </div>
          </ErrorBoundary>
        </AccessibilityProvider>
      </div>
    </AppLayout>
  );
};

const InsightsPage: React.FC = () => {
  return (
    <Suspense
      fallback={
        <div className="min-h-screen bg-slate-950 flex items-center justify-center">
          <div className="text-center">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-emerald-500 mx-auto mb-4"></div>
            <p className="text-slate-400">Loading insights...</p>
          </div>
        </div>
      }
    >
      <InsightsPageContent />
    </Suspense>
  );
};

export default InsightsPage;
